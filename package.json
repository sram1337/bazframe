{
  "name": "bazframe",
  "version": "0.1.0-beta.2",
  "description": "Manage reusable Agent Skills and profiles for coding-agent harnesses",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "bazframe": "dist/cli.js",
    "bzf": "dist/cli.js"
  },
  "files": [
    "artifacts/",
    "dist/",
    "docs/",
    "!docs/reviews/",
    "examples/",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sram1337/bazframe.git"
  },
  "homepage": "https://github.com/sram1337/bazframe#readme",
  "bugs": {
    "url": "https://github.com/sram1337/bazframe/issues"
  },
  "keywords": [
    "agent-skills",
    "coding-agent",
    "pi",
    "profiles"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:pack": "node ./scripts/test-pack.mjs",
    "test:real-pi": "node ./scripts/test-real-pi.mjs",
    "test:tui-terminal:local": "npm run build && node ./scripts/test-tui-terminal.mjs",
    "test:tui-terminal:linux": "npm run build && node ./scripts/test-tui-terminal-linux.mjs",
    "test": "npm run build && npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run test:pack",
    "release:check": "npm test && npm pack --dry-run --json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "ink-testing-library": "4.0.0",
    "string-width": "8.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.4",
    "ink": "7.1.1",
    "react": "19.2.8"
  }
}

{
  "name": "bazframe",
  "version": "0.1.0-beta.3",
  "description": "Manage reusable Agent Skills and profiles for coding-agent harnesses",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "bazframe": "dist/cli.js",
    "bzf": "dist/cli.js"
  },
  "files": [
    "artifacts/",
    "dist/",
    "docs/",
    "!docs/reviews/",
    "examples/",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sram1337/bazframe.git"
  },
  "homepage": "https://github.com/sram1337/bazframe#readme",
  "bugs": {
    "url": "https://github.com/sram1337/bazframe/issues"
  },
  "keywords": [
    "agent-skills",
    "coding-agent",
    "pi",
    "profiles"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "node ./scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "check:quick": "npm run typecheck && npm run lint && git diff --check && git diff --cached --check",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:publishing:unit": "npm run test:unit -- test/unit/profile-publishing test/unit/cli/command-results.test.ts test/unit/cli/json-output.test.ts test/unit/cli/parse-argv.test.ts test/unit/status/status.test.ts test/unit/application/tui-service.test.ts",
    "test:publishing:integration": "npm run test:integration -- test/integration/profile-export-cli.test.ts test/integration/profile-import-cli.test.ts test/integration/profile-management-cli.test.ts test/integration/profile-publishing-hidden.test.ts test/integration/profile-remote-materializer.test.ts test/integration/tui-cli-state-agreement.test.ts",
    "test:publishing": "npm run build && npm run test:publishing:unit && npm run test:publishing:integration",
    "check:publishing": "npm run check:quick && npm run test:publishing",
    "test:repeat": "node ./scripts/repeat-command.mjs",
    "session:summary": "node ./scripts/summarize-pi-session.mjs",
    "test:pack": "node ./scripts/test-pack.mjs",
    "test:real-pi": "node ./scripts/test-real-pi.mjs",
    "test:tui-terminal:local": "npm run build && node ./scripts/test-tui-terminal.mjs",
    "test:tui-terminal:linux": "npm run build && node ./scripts/test-tui-terminal-linux.mjs",
    "test": "npm run build && npm run typecheck && npm run lint && npm run test:unit && npm run test:integration && npm run test:pack",
    "release:check": "npm test && npm pack --dry-run --json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.2.18",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.0.0",
    "globals": "^17.0.0",
    "ink-testing-library": "4.0.0",
    "string-width": "8.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.4",
    "ink": "7.1.1",
    "react": "19.2.8",
    "yauzl": "3.4.0",
    "yazl": "3.3.1"
  }
}
